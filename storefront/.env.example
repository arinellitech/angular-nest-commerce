# Read by the SSR server at runtime (src/server.ts). Set these on Vercel → Project → Environment Variables.
# URL the SSR server uses to reach the API (can be an internal URL).
API_BASE_URL=http://localhost:8000
# URL the browser uses (defaults to API_BASE_URL). Set to the public API URL in production.
PUBLIC_API_BASE_URL=http://localhost:8000
# Extra Host-header allowlist for SSR (custom domains). localhost and *.vercel.app are built in (angular.json).
# NG_ALLOWED_HOSTS=loja.com.br,*.loja.com.br

# `ng serve` ignores these and uses src/environments/environment.development.ts (http://localhost:8000).
