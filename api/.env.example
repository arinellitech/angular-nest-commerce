NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000

# Storefront origin(s) allowed by CORS (comma-separated). Vercel preview URLs are allowed by pattern.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Database — PostgreSQL via Drizzle (node-postgres)
#
# Local (docker compose up -d postgres):
#   DATABASE_URL=postgres://commerce:commerce@127.0.0.1:5432/commerce
#
# Supabase (Project Settings → Database → Connection string):
#   Long-running server (Fly/Railway/Render) → "Session pooler", port 5432
#   Serverless                                → "Transaction pooler", port 6543
#   Always DATABASE_SSL=true with Supabase.
#
# DATABASE_DRIVER=pglite boots an in-memory Postgres (used by the test suite).
# ---------------------------------------------------------------------------
DATABASE_DRIVER=pg
DATABASE_URL=postgres://commerce:commerce@127.0.0.1:5432/commerce
DATABASE_SSL=false
DATABASE_POOL_MAX=10

COMMERCE_CURRENCY=BRL
CART_TTL_DAYS=30
ORDER_NUMBER_PREFIX=ORD
ORDER_PAYMENT_TTL_MINUTES=30
SHIPPING_FLAT_RATE_CENTS=1990
SHIPPING_FREE_OVER_CENTS=29900

# Payments — "mock" generates a fake Pix QR code and confirms via POST /api/v1/webhooks/mock
# (header X-Webhook-Secret). Swap for asaas|pagarme|stripe once the adapter exists (PROMPT 09).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-please

# Meilisearch (docker compose up -d meilisearch) — used from PROMPT 01.
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# Redis — BullMQ queues from PROMPT 04 (Upstash in prod).
REDIS_URL=redis://127.0.0.1:6379
